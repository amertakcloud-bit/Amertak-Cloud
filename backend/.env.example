# ───────── Server ─────────
PORT=5000
NODE_ENV=development

# Frontend origin(s) allowed to call this API (comma separated, no trailing slash).
# Production example: https://amertakcloud.vercel.app,https://www.yourdomain.com
CLIENT_URL=http://localhost:5173

# Public URL of THIS backend (used for share links / OAuth callbacks).
SERVER_URL=http://localhost:5000

# Long random string (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
SESSION_SECRET=

# ───────── Database ─────────
# Production (Vercel): MongoDB Atlas — allow 0.0.0.0/0 in Network Access.
# Local PC: leave MONGODB_URI empty and the app uses a SQLite file instead (works the same way).
#MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/amertak
# SQLite file used when MONGODB_URI is empty (default: backend/data/amertak.sqlite)
#DATABASE_PATH=./data/amertak.sqlite

# ───────── Gemini (SRT + Image→Prompt) ─────────
# Optional server key. Only LOGGED-IN users can use it; everyone else must paste their own key.
# Any key format is accepted (AIza…, AQ.…, …).
GEMINI_API_KEY=
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
GEMINI_MODEL=gemini-3.8-flash

# ───────── Google login (optional) ─────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ───────── Telegram login (optional) ─────────
TELEGRAM_BOT_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CALLBACK_URL=http://localhost:5000/api/auth/telegram/callback

# ───────── Payments (KHQR.dev — https://dash.khqr.dev) ─────────
# Store permanent token from the KHQR.dev dashboard (server only — never put it in the frontend)
RBK_TOKEN=
# Webhook signing secret (Dashboard → Webhooks). Webhook URL: https://YOUR-SITE/api/payments/webhook
KHQR_WEBHOOK_SECRET=
# Optional: your site URL, e.g. https://amertakcloud.vercel.app — enables hosted checkout (needs the domain verified in the dashboard)
#PAYMENT_RETURN_URL=
#KHQR_API_URL=https://api.khqr.dev/v1

# ───────── Limits ─────────
# Vercel rejects request bodies > 4.5 MB, so keep MAX_UPLOAD_MB ≤ 4 there.
MAX_UPLOAD_MB=4
MAX_FILE_SIZE_MB=100

# CloudShare database (a SEPARATE MongoDB database/cluster from MONGODB_URI).
# Files are stored here. On Vercel one upload is limited to ~4 MB by the platform.
CLOUD_MONGODB_URI=
# SQLite file used when CLOUD_MONGODB_URI is empty (default: backend/data/cloud.sqlite)
#CLOUD_DATABASE_PATH=./data/cloud.sqlite
# Optional: CloudShare max file size in MB (default 4 on Vercel, 15 elsewhere; hard cap 15)
CLOUDSHARE_MAX_MB=4

# Optional: separate secret for signing video download links (defaults to SESSION_SECRET)
# VIDEO_SIGN_SECRET=
# Optional: DNS servers used as fallback for mongodb+srv lookups
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Optional: separate secret used to encrypt users' saved Gemini keys (defaults to SESSION_SECRET).
# If you change it (or SESSION_SECRET) saved keys can no longer be decrypted and users must re-save them.
# KEY_ENCRYPTION_SECRET=

# ───────── Text to speech (Piseth / Sreymom) ─────────
# Microsoft blocks Edge TTS from many cloud IPs (Vercel → HTTP 403). The free Azure Speech key (F0 = 500k chars/month)
# gives the SAME voices and works everywhere: portal.azure.com → Create "Speech" → Keys and Endpoint.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia
# Edge TTS only (no Azure): run the same backend on another host (e.g. Render) and point Vercel to it:
#TTS_REMOTE_URL=https://YOUR-RENDER-APP.onrender.com/api/tts
